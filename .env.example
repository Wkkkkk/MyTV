# SQLite connection string. Default: sqlite:mytv.db
DATABASE_URL=sqlite:mytv.db

# Admin password for /admin and /api/admin (HTTP basic auth).
# Default in dev is 'admin' (server logs a warning when unset).
ADMIN_PASSWORD=changeme

# YouTube Data API key. Optional — discovery YouTube search is disabled if unset
# (the endpoint returns 503).
YOUTUBE_API_KEY=

# HTTP listen port. Default: 3000
PORT=3000

# Log level: trace | debug | info | warn | error (or a full RUST_LOG filter
# string, e.g. "mytv=debug,tower_http=info"). Default: info
RUST_LOG=info

# --- E2E smoke suite (tests/e2e.rs) ---
# Both must be set to run the suite (cargo test --test e2e -- --ignored).
# Loaded from this file if present; real env vars take precedence.
MYTV_BASE_URL=https://kunstv.fly.dev
MYTV_ADMIN_PASSWORD=changeme
